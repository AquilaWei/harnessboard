<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- The board itself runs in the browser's Trusted Web Activity, so the app keeps no data
         worth backing up: the saved board address is set up again by scanning the QR. -->
    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Harnessboard">

        <!-- Asks Google Play services to fetch the code scanner when the app is installed, so the
             first scan does not wait for the download. -->
        <meta-data
            android:name="com.google.mlkit.vision.DEPENDENCIES"
            android:value="barcode_ui" />

        <!-- Translucent: it only hands over to the browser or the setup screen. -->
        <activity
            android:name=".LauncherActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- Not exported: the launcher starts the "Change board" shortcut as this app, so other
             apps cannot make it forget the board. -->
        <activity
            android:name=".SetupActivity"
            android:exported="false" />
    </application>

    <!-- Android 11+ hides other apps unless declared: the launcher looks for browsers and for
         the ones whose Custom Tabs service supports Trusted Web Activities. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.support.customtabs.action.CustomTabsService" />
        </intent>
    </queries>
</manifest>
